{
  "schemaVersion": 1,
  "id": "antigravity-pool",
  "name": "Antigravity Pool",
  "version": "0.0.3",
  "entry": "plugin.js",
  "icon": "icon.svg",
  "brandColor": "#4285F4",
  "lines": [
    { "type": "progress", "label": "Gemini weekly", "scope": "overview", "primaryOrder": 1 },
    { "type": "progress", "label": "Gemini 5h", "scope": "overview", "primaryOrder": 2 },
    { "type": "text", "label": "Pool", "scope": "overview" },
    { "type": "pool", "label": "Accounts", "scope": "detail" },
    { "type": "heatmap", "label": "Requests", "scope": "detail" }
  ],
  "settings": [
    {
      "key": "baseUrl",
      "label": "Relay URL",
      "type": "url",
      "placeholder": "http://100.105.72.106:8317, http://192.168.0.234:8317",
      "help": "CLIProxyAPI base URL. Comma-separate several to try in order: Tailscale first, then LAN."
    },
    {
      "key": "managementKey",
      "label": "Management key",
      "type": "secret",
      "help": "MANAGEMENT_PASSWORD from the relay's .env. Stored in this plugin's config.json, mode 600."
    }
  ]
}
