# Leave unset to build an unsigned local app (macOS will ask you to confirm
# the first launch via right-click -> Open).
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Optional: notarization (only useful together with APPLE_SIGNING_IDENTITY)
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=
